# Model access: the neatHack LiteLLM proxy (OpenAI-compatible)
LITELLM_API_KEY=
LITELLM_BASE_URL=
# Models (list them with: pnpm crash models)
CW_AGENT_MODEL=claude-haiku-4-5
CW_FIXER_MODEL=claude-sonnet-4-5

# neatlogs ingest: the SDK key the app exports traces with
NEATLOGS_API_KEY=

# neatlogs readback: an expiring, project-bound service-account token (observability:read).
# Never the same value as NEATLOGS_API_KEY.
NEATLOGS_TOKEN=
# Or, without a service-account token: a neatlogs-cli profile signed in once with
#   env -u NEATLOGS_API_KEY -u NEATLOGS_TOKEN -u NEATLOGS_PROJECT_ID npx neatlogs-cli --host https://app.neatlogs.com \
#     --profile setup-https---app-neatlogs-com auth login --device [--allow-file-credentials]
CW_NEATLOGS_PROFILE=
# Optional: defaults to the project bound to the token, and the US origin
NEATLOGS_PROJECT_ID=
NEATLOGS_HOST=https://app.neatlogs.com

# Optional: hard cap on cost per task (USD) enforced by the gate
CW_COST_CAP=
